@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Eigen3 REQUIRED)
find_dependency(urdfdom REQUIRED)

set(TetraPGA_DESCRIPTION_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/TetraPGA/description")

include("${CMAKE_CURRENT_LIST_DIR}/TetraPGATargets.cmake")

check_required_components(TetraPGA)
